    "import tweepy\n",
    "import geopy\n",
    "import keys # import the keys.py file to bring in bearer_token\n",
    "\n",
    "#Authenticate with Twitter\n",
    "client = tweepy.Client(bearer_token =keys.bearer_token)\n",
    "print('Connected to Twitter successfully')\n",
    "#get information about account\n",
    "acct = client.get_user(username='#{TYPE USER NAME}', user_fields=['description', 'public_metrics'])\n",
    "print(f'Account id number:\\t {acct.data.id}')\n",
    "print(f'Name on Account:\\t {acct.data.name}')\n",
    "print(f'Account Twitter handle:\\t {acct.data.username}')\n",
    "print(f'\\nDescription: {acct.data.description}\\n')\n",
    "print(f\"Followers:\\t\\t {acct.data.public_metrics['followers_count']}\")\n",
    "print(f\"Following:\\t\\t {acct.data.public_metrics['following_count']}\")\n",
    "print(f\"Tweets:\\t\\t\\t {acct.data.public_metrics['tweet_count']}\")\n",
    "\n"
   ]
